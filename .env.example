# docker-compose.prod.yml / README.md의 "로컬에서 운영 설정을 재현" 절차에서 사용하는 예시 파일입니다.
# 실제 값을 채운 뒤 .env로 저장하세요. .env는 .gitignore에 등록되어 있어 커밋되지 않습니다.

# MySQL root 비밀번호
DB_PASSWORD=

# RabbitMQ 계정 (USERNAME 미설정 시 guest로 기본 적용)
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=

# JWT 서명 키 (최소 256비트/32자 이상 무작위 문자열 권장, 예: openssl rand -base64 32)
JWT_SECRET=

# CORS 허용 출처 (콤마로 구분, 선택 사항). 네이티브 앱만 호출한다면 비워둬도 무방.
# 웹 프론트엔드가 생기면 실제 도메인으로 채울 것 (예: https://app.climbingwith.com)
CORS_ALLOWED_ORIGINS=

# Docker Hub 계정 (이미지 push/pull용)
DOCKER_USERNAME=
